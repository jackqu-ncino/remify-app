# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (email sending)
RESEND_API_KEY=re_your_api_key

# The email address reminders will be sent FROM
RESEND_FROM_EMAIL=reminders@yourdomain.com

# Secret used to protect the cron endpoint
CRON_SECRET=change-me-to-a-random-string

# Your app's public URL (used in email links)
NEXT_PUBLIC_APP_URL=https://yourdomain.com
