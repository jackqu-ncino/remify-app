# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Resend (email) ────────────────────────────────────────────────────────────
# Found in Resend dashboard → API Keys
RESEND_API_KEY=re_your_api_key
# The verified sending address on your Resend domain
RESEND_FROM_EMAIL=reminders@remify.app

# ── App ───────────────────────────────────────────────────────────────────────
# Public URL used to build links inside emails
NEXT_PUBLIC_APP_URL=https://remify.app

# ── Cron ─────────────────────────────────────────────────────────────────────
# A random secret string — must match the value set in Vercel environment variables
# Used to protect /api/cron/reminders and /api/preview-email
# Generate one with: openssl rand -base64 32
CRON_SECRET=your-random-secret

# ── Admin ─────────────────────────────────────────────────────────────────────
# Password for the /admin page — entered manually each visit (no session stored)
# Generate one with: openssl rand -base64 32
ADMIN_SECRET=your-admin-secret
